HTML_CONTENT += r"""<script>
let socket;let currentStep=1;const authScreen=document.getElementById('auth-screen');const mainScreen=document.getElementById('main-screen');const termEl=document.getElementById('terminal-screen');
window.onload=function(){const u=localStorage.getItem('m_u');const p=localStorage.getItem('m_p');if(u&&p)startCoreConnection(u,p);};
function processRegistration(){const u=document.getElementById('reg-user').value.trim();const p=document.getElementById('reg-project').value.trim();if(!u||!p)return alert('Заполните поля!');localStorage.setItem('m_u',u);localStorage.setItem('m_p',p);startCoreConnection(u,p);}
function startCoreConnection(u,p){authScreen.classList.remove('active');mainScreen.classList.add('active');termEl.innerHTML='> Развертывание протоколов...';const proto=window.location.protocol==='https:'?'wss://':'ws://';socket=new WebSocket(proto+window.location.host+'/ws');
socket.onopen=function(){socket.send(JSON.stringify({type:"auth",user:u,project:p}));};
socket.onmessage=function(e){termEl.innerHTML+='<br><span style="color:#39ff14;">🤖 '+e.data+'</span>';termEl.scrollTop=termEl.scrollHeight;};
socket.onclose=function(){termEl.innerHTML+='<br><span style="color:#ff3344;">⚡ Разрыв связи.</span>';};}
function nextOnboardingStep(){currentStep++;const t=document.getElementById('onboard-title');const d=document.getElementById('onboard-desc');
if(currentStep===2){t.innerText="Шаг 2 из 3: Вопросы Марго";d.innerText="Используйте поле ввода для отправки любых b2b команд в ядро.";}
else if(currentStep===3){t.innerText="Шаг 3 из 3: Сброс памяти";d.innerText="Нижняя красная кнопка полностью сотрет локальный кэш вашего профиля.";}
