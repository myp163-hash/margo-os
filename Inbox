import os
import json
import httpx
from fastapi import FastAPI, WebSocket, WebSocketDisconnect
from fastapi.responses import HTMLResponse

app = FastAPI()

# Конфигурация локального движка Ollama
OLLAMA_URL = "http://localhost:11434/api/generate"
MODEL_MARGO = "granite4.1:8b"   # Тяжелая модель строго для Марго
MODEL_GIRLS = "llama3.2:1b"     # Легкая модель для консилиума девчонок

HTML_CONTENT = r"""<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>MARGO NEXUS v23</title>
    <style>
        :root{--bg:#060913;--panel:rgba(15,23,42,0.85);--neon:#00f3ff;--purple:#bf5af2;--green:#32d74b;--red:#ff453a;}
