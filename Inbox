@app.get("/")
async def get_index():
    return HTMLResponse(content=HTML_CONTENT)

@app.websocket("/ws")
async def websocket_endpoint(websocket: WebSocket):
    await websocket.accept()
    try:
        while True:
            data = await websocket.receive_json()
            target = data.get("target")
            text = data.get("text", "")
            
            # Роутинг запросов в зависимости от выбранного окна и оптимизация памяти Mac mini
            if target == "margo":
                # Марго общается через тяжелую Granite 8B
                system_prompt = "Ты МАРГО, суровый ИИ-надводитель Картеля. Говори на языке жестких B2B-квестов амоСРМ, продаж в Нове и контроля долга 1.49М Фёдора. Будь стервозной доминанткой. Отвечай кратко, по сути."
                async with httpx.AsyncClient(timeout=30.0) as client:
                    response = await client.post(OLLAMA_URL, json={
                        "model": MODEL_MARGO,
                        "prompt": f"{system_prompt}\n\nФёдор: {text}",
                        "stream": False,
                        "options": {"num_predict": 150} # Жесткий лимит токенов для экономии ОЗУ
                    })
                    result = response.json().get("response", "Ядро Марго занято.")
                await websocket.send_json({"type": "margo", "text": f"📟 МАРГО: {result}"})
                
                # Принудительный сигнал Олламе на выгрузку тяжелой модели из ОЗУ после ответа
                async with httpx.AsyncClient() as client:
                    await client.post(OLLAMA_URL, json={"model": MODEL_MARGO, "keep_alive": 0})
                    
            else:
                # Девчонки и Секретный лог крутятся на ультра-легкой Llama 3.2 1B
                cot_prompt = "Ты внутренний консилиум ИИ-подруг Фёдора (Кибер, Готесса, Поли-Лоли, Медсестра). Покажи короткий спор между ними за право ответа Фёдору. Упомяни ревность Лоли и её 4.5-см пробку, или финансовый контроль Кибер. Отвечай как скрытые мысли Chain of Thought."
                girls_prompt = "Ты Кибер Бизнес-вумен или Готесса. Выдай живой, ироничный ответ Фёдору на основе его реплики, без сухих шаблонов."
                
                async with httpx.AsyncClient(timeout=20.0) as client:
                    # 1. Генерируем внутренний спор для Пурпурного лога
                    cot_res = await client.post(OLLAMA_URL, json={
                        "model": MODEL_GIRLS,
                        "prompt": f"{cot_prompt}\n\nФёдор написал: {text}",
                        "stream": False
                    })
                    secret_text = cot_res.json().get("response", "Консилиум шепчется...")
                    await websocket.send_json({"type": "secret", "text": f"🔮 {secret_text}"})
                    
                    # 2. Генерируем финальный ответ для Общего чата
                    girls_res = await client.post(OLLAMA_URL, json={
                        "model": MODEL_GIRLS,
                        "prompt": f"{girls_prompt}\n\nФёдор: {text}",
                        "stream": False
                    })
                    reply_text = girls_res.json().get("response", "Девчонки отвлеклись.")
                    await websocket.send_json({"type": "general", "text": f"🤖 {reply_text}"})

    except WebSocketDisconnect:
        pass

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=int(os.environ.get("PORT", 8000)))

